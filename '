* {
  margin: 0px;
  padding: 0px;
  box-sizing: border-box;
  font-family: "JetBrains Mono", monospace;
}

body {
  background-color: #181616;
  height: 100vh;
  max-height: 100vh;
  width: 100%;
  display: flex;
}

.title {
  height: 100%;
  width: 40%;
  display: flex;
  flex-direction: column;
}

.titles {
  display: flex;
  flex-direction: column;
  color: white;
  height: 30%;
  justify-content: center;
  align-items: center;
}

.titles h2 {
  font-size: 4rem;
  text-align: left;
}
.titles h1 {
  font-size: 1.5rem;
  text-align: left;
}

.sections {
  flex-grow: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 2rem;
}

.sections p {
  font-size: 1.5rem;
  color: white;
}

.content {
  width: 60%;
  background-color: blue;
}
